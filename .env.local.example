# Copy this file to .env.local and fill in your values.
#
# This app shares v-1's database — point these at the same Supabase project as v-1.
# Its tables are all prefixed `er_` and drizzle.config.ts scopes drizzle-kit to them.

# Pooled connection (used by the app at runtime)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct/unpooled connection (used by db:push / db:migrate — pooler doesn't support DDL)
# DATABASE_URL_UNPOOLED=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL_UNPOOLED=

# JWT signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: public origin used to build shareable event links (e.g. https://events.example.com).
# When unset, the link is built from the incoming request's host.
APP_URL=
